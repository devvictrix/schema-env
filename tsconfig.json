{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    // tsup hardcodes `baseUrl` in its DTS build, which TypeScript 6 flags as deprecated. Drop once tsup stops doing that.
    "ignoreDeprecations": "6.0",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "isolatedModules": true,
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "tests/index.test.ts", "tests/zod-compat.test.ts"],
  "exclude": ["node_modules", "dist", "**/*.cjs"]
}
